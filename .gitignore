# OpenHarmony / HarmonyOS(鸿蒙)适配
#
# 签名材料是「你的」签名身份,泄露等于任何人都能冒充你的应用签名,
# 因此这里显式忽略(ohos/.gitignore 里也有一份)。
/ohos/signing/
/ohos/local.properties
/ohos/node_modules/
/ohos/oh_modules/
/ohos/.hvigor/
/ohos/entry/oh_modules/
/ohos/entry/build/
/ohos/entry/.hvigor/
/ohos/entry/src/main/resources/rawfile/flutter_assets/
/ohos/entry/libs/

# toolchain/ohos 的本地产物(备份、下载的二进制、npm 依赖)
/toolchain/ohos/backup/
/toolchain/ohos/agc-cli/node_modules/
/toolchain/ohos/ohos-aot-win/
/toolchain/ohos/fs_build/
__pycache__/
*.pyc

# 打包给终端用户的安装产物
/saber-ohos-kit/

# 依赖覆盖文件:仓库里存的是 toolchain/ohos/pubspec_overrides.yaml,
# 构建时由 scripts/build_ohos.sh 复制到根目录。根目录这份是本地产物,
# 提交上去会让与鸿蒙无关的构建也被迫拉取鸿蒙分支插件。
/pubspec_overrides.yaml
